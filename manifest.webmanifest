{
  "name": "Jurassic Fight",
  "short_name": "Jurassic Fight",
  "description": "A dinosaur fighting game: ten dinosaurs, sixty-five million years of frame data.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#14110d",
  "theme_color": "#14110d",
  "related_applications": [
    { "platform": "webapp", "url": "https://deryvad.github.io/jurassic-fight/manifest.webmanifest" }
  ],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
